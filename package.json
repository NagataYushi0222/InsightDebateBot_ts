{
  "name": "insightdebatebot",
  "version": "1.0.0",
  "description": "Discord上のボイスチャットを自動録音・分析し、議論の要約や対立構造を可視化するAI Botです。",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "postinstall": "bun run scripts/patch-ovencord-voice.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index_with_vc_article.ts --outdir dist --target bun"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NagataYushi0222/InsightDebateBot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NagataYushi0222/InsightDebateBot/issues"
  },
  "homepage": "https://github.com/NagataYushi0222/InsightDebateBot#readme",
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@noble/ciphers": "^2.1.1",
    "@ovencord/util": "^1.10.0",
    "@ovencord/voice": "^0.19.8",
    "@snazzah/davey": "^0.1.10",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.4",
    "libsodium-wrappers": "^0.8.2",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
